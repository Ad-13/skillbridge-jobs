# Local development. On Render set the same keys as environment
# variables, but omit PORT — the platform provides it.

PORT=4000
NODE_ENV=development

# Auth0 tenant domain, with scheme.
OIDC_ISSUER=https://YOUR-TENANT.eu.auth0.com

# Same identifier in every service — it becomes the `aud` claim.
API_AUDIENCE=https://skillbridge-api

# This service holds no client credentials and no session secret:
# it never logs anyone in. It only verifies tokens other services present.
